<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_alias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_my_trips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis viajes"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_other_trips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Viajes de otros usuarios"
        android:layout_marginBottom="32dp"/>

    <!-- Technical info kept but less prominent -->
    <TextView
        android:id="@+id/tv_token"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Token"
        android:textSize="12sp"
        android:visibility="gone" 
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_expiration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expiration"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="@android:color/holo_red_light"/>

</LinearLayout>
